static void mpic_end_gpt(struct irq_data *d)
{
	struct mpic *mpic = mpic_from_gpt(d->irq);

	BUG_ON(!mpic || d->irq < mpic->timer_vecs[0]
			|| d->irq > mpic->timer_vecs[MPIC_NUM_GPTS - 1]);

	mpic_eoi(mpic);
}

