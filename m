-
-		bdp = fep->rx_bd_base;
-		printk(" rx: %lu buffers\n",  RX_RING_SIZE);
-		for (i = 0 ; i < RX_RING_SIZE; i++) {
-			printk("  %08x: %04x %04x %08x\n",
-			       (uint) bdp,
