-static void
-mpc5xxx_fec_set_multicast_list(struct rtnet_device *dev)
-{
-	struct mpc5xxx_fec_priv *priv = (struct mpc5xxx_fec_priv *)dev->priv;
-	struct mpc5xxx_fec *fec = priv->fec;
-	u32 u32_value;
-
-	if (dev->flags & IFF_PROMISC) {
