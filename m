S.Gerber,
> > G.Boutillier and D.Rossier
> >  > + * University of Applied Sciences Western Switzerland
> >  > + * Reconfigurable & Embedded Digital Systems, REDS Institute
> >  > + *
> >  >   */
> >  >
> >  >  #include <linux/config.h>
> >  > @@ -320,11 +326,19 @@ static void __ipipe_set_decr(void)
> >  >  int ipipe_tune_timer(unsigned long ns, int flags)
> >  >  {
> >  >  	unsigned long x, ticks;
> >  > +	unsigned long us;
> >  >
> >  >  	if (flags & IPIPE_RESET_TIMER)
> >  >  		ticks =3D __ipipe_mach_ticks_per_jiffy;
> >  >  	else {
> >  > -		ticks =3D ns * __ipipe_mach_ticks_per_jiffy / (1000000000
> / HZ);
> >  > +
> >  > +		/*
> >  > +		 * FIXME : Temporary convert ns to us. With nanosecondes
> we
> > have a problem
> >  > +                 *         with overflow.
> >  > +		 *         ticks =3D ns * __ipipe_mach_ticks_per_jiffy /
> > (1000000000 / HZ);
> >  > +		 */
> >  > +		us =3D ns / 1000;
> >  > +		ticks =3D ((us * __ipipe_mach_ticks_per_jiffy) / 10000);
> >  >
> >
> > This change is going to be wrong when CONFIG_HZ !=3D 1000,
> > this is why HZ should remain in the picture. This said, the original
> > expression looks
> > overly complicated, something like the following should do without
> risking
> > the overflow:
> >
> > -		ticks =3D ns * __ipipe_mach_ticks_per_jiffy / (1000000000 / HZ);
> > +		ticks =3D ns / (TICKS_PER_uSEC * 1000);
> >
> >  >  		if (ticks > __ipipe_mach_ticks_per_jiffy)
> >  >  			return -EINVAL;
> >
>=20
> Agreed. We propose the following changes in order to get a better
> precision:
>=20
>=20
> +		ticks =3D __ipipe_mach_ticks_per_jiffy;
> +	else {
> +
> +		//FIXME : Problem with value of ns < 1000
> +		ticks =3D (ns / 1000) * (__ipipe_mach_ticks_per_jiffy) /
> (1000000 / HZ);
> +
> +		if (ticks > __ipipe_mach_ticks_per_jiffy)
> +			return -EINVAL;
> +	}
>=20
>=20
