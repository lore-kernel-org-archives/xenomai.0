int orcTimerSigMask(void)
{
    sigset_t set;
    sigfillset(&set);
    if ((err2 =3D pthread_sigmask(SIG_BLOCK, &set, NULL)) !=3D OK)
    {
        printf("pthread_sigmask Failed %d \n", err2);
        return ERROR;
    }
    sigemptyset(&set);
    sigaddset(&set, SIGINT);
    sigaddset(&set, SIGTERM);
    if ((err2 =3D pthread_sigmask(SIG_UNBLOCK, &set, NULL)) !=3D OK)
    {
        printf("pthread_sigmask Failed %d \n", err2);
        return ERROR;
    }

    return OK;
}

void setTimer(void)
