-static void mdio_timer_callback(unsigned long data)
-{
-	struct rtnet_device *dev = (struct rtnet_device *)data;
-	struct mpc5xxx_fec_priv *priv = (struct mpc5xxx_fec_priv *)(dev->priv);
-	mii_do_cmd(dev, priv->phy->ack_int);
-
-	if (priv->link_up) {
