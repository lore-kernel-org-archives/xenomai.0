-	uint	phy_id_done;
-	uint	phy_status;
-	phy_info_t	*phy;
-	struct tq_struct phy_task;
-
-	uint	sequence_done;
-
-	uint	phy_addr;
-#endif	/* CONFIG_XENO_DRIVERS_NET_USE_MDIO */
-
-	int	link;
-	int	old_link;
-	int	full_duplex;
-
-	fcc_info_t	*fip;
-};
