-				gaddr1 |= 1 << (crc-32);
-			else
-				gaddr2 |= 1 << crc;
-			dmi = dmi->next;
-		}
-		out_be32(&fec->gaddr1, gaddr1);
-		out_be32(&fec->gaddr2, gaddr2);
-	}
