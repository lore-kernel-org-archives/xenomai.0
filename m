-#define MDIO_DELAY	5
-
-#define FCC_MDIO(bit) do {					\
-	udelay(MDIO_DELAY);					\
-	if (bit)						\
-		IOP_DAT(io,fip->fc_port) |= fip->fc_mdio;	\
-	else							\
-		IOP_DAT(io,fip->fc_port) &= ~fip->fc_mdio;	\
-} while(0)
-
-#define FCC_MDC(bit) do {					\
-	udelay(MDIO_DELAY);					\
-	if (bit)						\
-		IOP_DAT(io,fip->fc_port) |= fip->fc_mdck;	\
-	else							\
-		IOP_DAT(io,fip->fc_port) &= ~fip->fc_mdck;	\
-} while(0)
