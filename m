-static uint
-mii_send_receive(fcc_info_t *fip, uint cmd)
-{
-	uint		retval;
-	int		read_op, i, off;
-	volatile	immap_t		*immap;
-	volatile	iop8260_t	*io;
-
-	immap = (immap_t *)IMAP_ADDR;
-	io = &immap->im_ioport;
-
-	IOP_DIR(io,fip->fc_port) |= (fip->fc_mdio | fip->fc_mdck);
-
-	read_op = ((cmd & 0xf0000000) == 0x60000000);
-
-	/* Write preamble
-	 */
-	for (i = 0; i < 32; i++)
-	{
-		FCC_MDC(0);
-		FCC_MDIO(1);
-		FCC_MDC(1);
-	}
-
-	/* Write data
-	 */
-	for (i = 0, off = 31; i < (read_op ? 14 : 32); i++, --off)
-	{
-		FCC_MDC(0);
-		FCC_MDIO((cmd >> off) & 0x00000001);
-		FCC_MDC(1);
-	}
-
-	retval = cmd;
-
-	if (read_op)
-	{
-		retval >>= 16;
-
-		FCC_MDC(0);
-		IOP_DIR(io,fip->fc_port) &= ~fip->fc_mdio;
-		FCC_MDC(1);
-		FCC_MDC(0);
-
-		for (i = 0, off = 15; i < 16; i++, off--)
-		{
-			FCC_MDC(1);
-			udelay(MDIO_DELAY);
-			retval <<= 1;
-			if (IOP_DAT(io,fip->fc_port) & fip->fc_mdio)
-				retval++;
-			FCC_MDC(0);
-		}
-	}
-
-	IOP_DIR(io,fip->fc_port) |= (fip->fc_mdio | fip->fc_mdck);
-
-	for (i = 0; i < 32; i++)
-	{
-		FCC_MDC(0);
-		FCC_MDIO(1);
-		FCC_MDC(1);
-	}
-
-	return retval;
-}
