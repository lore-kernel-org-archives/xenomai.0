-#else
-		mpc5xxx_fec_link_up(dev);
-		return;
-#endif /* ORIGINAL_CODE */
-	}
-	/* Reschedule in 1 second */
-	priv->phy_timer_list.expires = jiffies + (1000 * HZ / 1000);
-	add_timer(&priv->phy_timer_list);
-}
